{
  "manifest_version": 3,
  "name": "Loterias Caixa Turbo - Apostas em lote (não oficial)",
  "version": "1.2.1",
  "description": "Auxiliar não oficial: preenche vários jogos da Mega-Sena ou da Lotofácil no portal Loterias Online da Caixa e adiciona cada um ao carrinho automaticamente.",
  "permissions": ["scripting"],
  "host_permissions": [
    "https://*.loteriasonline.caixa.gov.br/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Loterias Caixa Turbo",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.loteriasonline.caixa.gov.br/*"],
      "js": ["jogos.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
